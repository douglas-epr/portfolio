---
import { experiences } from '@/data/experience';
import { educations } from '@/data/education';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const now = new Date();

/** "Jan 2022" or "2011" → a Date at the first of that month. "Present" → now. */
function parseDate(value: string): Date {
  if (value === 'Present') return now;
  const [a, b] = value.split(' ');
  if (b === undefined) return new Date(Number(a), 0, 1);
  return new Date(Number(b), Math.max(0, MONTHS.indexOf(a ?? 'Jan')), 1);
}

const developerStart = parseDate(experiences.find((job) => job.id === 'freelance')?.startDate ?? 'Jan 2022');
const yearsAsDeveloper = Math.round((now.getTime() - developerStart.getTime()) / (365.25 * 24 * 3600 * 1000));
const roleCount = experiences.length;
const schoolCount = educations.length;

// Real durations, drawn as bars on one shared time axis from the earliest role to today.
const spans = experiences.map((job) => ({ start: parseDate(job.startDate), end: parseDate(job.endDate) }));
const axisStart = Math.min(...spans.map((s) => s.start.getTime()));
const axisEnd = now.getTime();
const pct = (t: number) => ((t - axisStart) / (axisEnd - axisStart)) * 100;
const bars = spans.map((s) => ({ offset: pct(s.start.getTime()), width: Math.max(1.5, pct(s.end.getTime()) - pct(s.start.getTime())) }));
const axisYears = Array.from({ length: now.getFullYear() - new Date(axisStart).getFullYear() + 1 }, (_, i) => new Date(axisStart).getFullYear() + i).filter((y) => y % 5 === 0 || y === now.getFullYear());
---

<section id="resume" class="chapter" data-sc-act="flow" data-chapter-title="Career">
  <div class="sc-wrap">
    <header class="chapter__head" data-sc-in data-sc-stagger="60">
      <p class="folio"><b>§02</b> · Career</p>
      <h2 class="sc-display sc-display--md">Five roles. One habit: measure before you change anything.</h2>
      <p class="figures mono">
        <span><b>{yearsAsDeveloper}</b> years as a developer</span>
        <span><b>{roleCount}</b> roles</span>
        <span><b>{schoolCount}</b> institutions</span>
      </p>
    </header>

    <div class="panel timeline">
      <div class="panel__bar"><span>experience · 2026 CV</span><span>{new Date(axisStart).getFullYear()} → today</span></div>
      <div class="axis mono" aria-hidden="true">
        {axisYears.map((year) => <span style={`--o: ${pct(new Date(year, 0, 1).getTime())}`}>{year}</span>)}
      </div>
      <ol class="roles">
        {experiences.map((job, index) => (
          <li class="role" data-sc-reveal="left" data-sc-reveal-at={`${(0.06 + index * 0.06).toFixed(2)} ${(0.3 + index * 0.06).toFixed(2)}`}>
            <div class="role__when mono">
              <span>{job.startDate}</span>
              <span>{job.endDate}</span>
            </div>
            <div class="role__who">
              <h3>{job.role}</h3>
              <p class="role__firm">{job.company} <span class="role__loc">· {job.location}</span></p>
              <div class="role__track" style={`--o: ${bars[index]?.offset.toFixed(2)}; --w: ${bars[index]?.width.toFixed(2)}; --i: ${index}`} aria-hidden="true"><span class="role__fill"></span></div>
              {job.stack ? <p class="role__stack mono">{job.stack.join(' · ')}</p> : null}
            </div>
            <ul class="role__notes">
              {(index === 0 ? job.highlights : job.highlights.slice(0, 2)).map((line) => <li>{line}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>

    <div class="panel schools" data-sc-in>
      <div class="panel__bar"><span>education</span><span>{schoolCount} rows</span></div>
      <ol class="schools__list" data-sc-in data-sc-stagger="70">
        {educations.map((school) => (
          <li>
            <span class="mono">{school.startYear === school.endYear ? school.endYear : `${school.startYear}–${school.endYear}`}</span>
            <span><b>{school.institution}</b> · {school.degree}, {school.field}</span>
            <span class="schools__loc mono">{school.location}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .figures { display: flex; flex-wrap: wrap; gap: var(--sc-5); color: var(--ink-soft); margin: 0; }
  .figures b { font-family: var(--sc-font-text); font-size: var(--sc-t-xl); font-weight: 560; color: var(--ink); margin-right: 0.2em; letter-spacing: -0.02em; }

  .axis { position: relative; height: 1.6rem; margin: 0 var(--sc-4); border-bottom: 1px dashed var(--hairline-strong); color: var(--ink-soft); }
  .axis span { position: absolute; left: calc(var(--o) * 1%); bottom: 4px; transform: translateX(-50%); }
  .axis span:first-child { transform: none; }
  .axis span:last-child { transform: translateX(-100%); }

  .roles { list-style: none; margin: 0; padding: 0; }
  .role {
    display: grid; grid-template-columns: 7.5rem minmax(0, 1.1fr) minmax(0, 1.5fr);
    gap: var(--sc-6); padding: var(--sc-5) var(--sc-4); border-bottom: 1px solid var(--hairline);
  }
  .role:last-child { border-bottom: 0; }
  .role__when { display: grid; gap: 2px; color: var(--ink-soft); padding-top: 0.35em; }
  .role__who h3 { margin: 0; font-size: var(--sc-t-lg); font-weight: 560; letter-spacing: -0.01em; line-height: 1.2; text-wrap: balance; }
  .role__firm { margin: var(--sc-2) 0 0; font-size: var(--sc-t-sm); }
  .role__loc { color: var(--ink-soft); }
  /* The bar is the role's real span on the shared axis; it grows with scroll. */
  .role__track { position: relative; height: 4px; margin: var(--sc-3) 0 0; background: var(--hairline); border-radius: 2px; overflow: hidden; }
  .role__fill {
    position: absolute; top: 0; bottom: 0; left: calc(var(--o) * 1%); width: calc(var(--w) * 1%);
    background: var(--accent); border-radius: 2px; transform-origin: left center;
    transform: scaleX(clamp(0, (var(--sc-p, 1) - 0.12 - var(--i) * 0.04) / 0.28, 1));
  }
  .role__stack { margin: var(--sc-3) 0 0; color: var(--ink-soft); line-height: 1.6; }
  .role__notes { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--sc-3); color: var(--ink-soft); font-size: var(--sc-t-sm); line-height: 1.55; text-wrap: pretty; }
  .role__notes li { padding-left: var(--sc-4); position: relative; }
  .role__notes li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 0.5rem; height: 1px; background: var(--accent); }
  .role:first-child .role__notes { color: var(--ink); }

  .schools { margin-top: var(--sc-5); }
  .schools__list { list-style: none; margin: 0; padding: 0; }
  .schools__list li { display: grid; grid-template-columns: 7.5rem 1fr auto; gap: var(--sc-6); padding: var(--sc-3) var(--sc-4); border-bottom: 1px solid var(--hairline); font-size: var(--sc-t-sm); }
  .schools__list li:last-child { border-bottom: 0; }
  .schools__list b { font-weight: 500; }
  .schools__loc { color: var(--ink-soft); }

  @media (max-width: 860px) {
    .role { grid-template-columns: 1fr; gap: var(--sc-4); }
    .role__when { display: flex; gap: var(--sc-3); }
    .role__when span + span::before { content: '→ '; }
    .schools__list li { grid-template-columns: 1fr; gap: var(--sc-1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .role__fill { transform: none; }
  }
</style>
