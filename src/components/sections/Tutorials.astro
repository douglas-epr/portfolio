---
import { ArrowUpRight } from '@lucide/astro';
import { tutorials } from '@/data/tutorials';
import { person } from '@/data/person';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
---

<section id="tutorials" class="chapter" data-sc-act="flow" data-chapter-title="Teaching">
  <div class="sc-wrap">
    <header class="chapter__head" data-sc-in data-sc-stagger="60">
      <p class="folio"><b>§07</b> · Teaching</p>
      <h2 class="sc-display sc-display--md">Bubble, taught on camera.</h2>
      <p class="sc-body">Four recordings from the channel. Each one works through a real problem in a real app. <a class="text-link" href={person.youtubeUrl} target="_blank" rel="noopener noreferrer">All videos on YouTube <ArrowUpRight size={14} aria-hidden="true" /></a></p>
    </header>

    <ol class="videos" data-sc-in data-sc-stagger="90">
      {tutorials.map((video) => (
        <li class="video panel">
          <div class="panel__bar"><span>youtube · {video.youtubeId}</span><span>{video.start ? `from ${Math.floor(video.start / 60)}:${String(video.start % 60).padStart(2, '0')}` : 'from start'}</span></div>
          <YouTubeEmbed id={video.youtubeId} title={video.title} start={video.start} />
          <div class="video__copy">
            <h3 class="video__title">{video.title}</h3>
            <p class="video__desc">{video.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .videos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2vw, 1.5rem); }
  .video__copy { padding: var(--sc-4); display: grid; gap: var(--sc-2); }
  .video__title { margin: 0; font-size: var(--sc-t-base); font-weight: 500; line-height: 1.4; text-wrap: balance; }
  .video__desc { margin: 0; color: var(--ink-soft); font-size: var(--sc-t-sm); }
  .chapter__head a { display: inline-flex; align-items: center; gap: 0.3em; }
  @media (max-width: 860px) {
    .videos { grid-template-columns: 1fr; }
  }
</style>
