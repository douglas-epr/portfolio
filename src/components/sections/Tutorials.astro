---
import { ArrowUpRight } from '@lucide/astro';
import { tutorials } from '@/data/tutorials';
import { person } from '@/data/person';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
---

<section id="tutorials" class="ground--dark chapter" data-sc-act="flow" data-chapter-title="Teaching">
  <div class="sc-wrap">
    <header class="chapter__head" data-sc-in data-sc-stagger="60">
      <p class="folio"><b>§07</b> · Teaching</p>
      <h2 class="sc-display sc-display--lg">Bubble, taught on camera.</h2>
      <p class="sc-body">Four recordings from the channel. Each one works through a real problem in a real app, not a template. <a class="text-link" href={person.youtubeUrl} target="_blank" rel="noopener noreferrer">All videos on YouTube <ArrowUpRight size={14} aria-hidden="true" /></a></p>
    </header>

    <ol class="videos" data-sc-in data-sc-stagger="90" data-ledger={`${tutorials.length} tutorials on YouTube`}>
      {tutorials.map((video) => (
        <li class="video">
          <YouTubeEmbed id={video.youtubeId} title={video.title} start={video.start} />
          <h3 class="video__title">{video.title}</h3>
          <p class="video__desc">{video.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .videos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 4rem); }
  .video { display: grid; gap: var(--sc-3); }
  .video__title { margin: var(--sc-2) 0 0; font-size: var(--sc-t-base); font-weight: 500; line-height: 1.4; text-wrap: balance; }
  .video__desc { margin: 0; color: var(--sc-ink-soft); font-size: var(--sc-t-sm); }
  .chapter__head a { display: inline-flex; align-items: center; gap: 0.3em; }
  @media (max-width: 860px) {
    .videos { grid-template-columns: 1fr; }
  }
</style>
