---
import { Image } from 'astro:assets';
import { projects } from '@/data/projects';
import ProjectDialog from '@/components/ProjectDialog.astro';

const featured = projects.filter((project) => project.featured);
const revealFor = (index: number) => {
  const from = Math.min(0.08 + index * 0.07, 0.6);
  return `${from.toFixed(2)} ${(from + 0.22).toFixed(2)}`;
};
---

<section id="projects" class="chapter" data-sc-act="flow" data-chapter-title="Projects">
  <div class="sc-wrap">
    <header class="chapter__head" data-sc-in data-sc-stagger="60">
      <p class="folio"><b>§05</b> · Projects</p>
      <h2 class="sc-display sc-display--md">Eight products in production, not prototypes.</h2>
      <p class="sc-body">Marketplaces, a CRM, a fitness subscription, a company operating system. Each label is a fact: name, category, tool count. Open one to read what was built, for whom, and with what.</p>
    </header>

    <ol class="objects">
      {featured.map((project, index) => (
        <li class="object panel">
          <button class="object__open" type="button" data-project-open={project.id} aria-haspopup="dialog">
            <span class="panel__bar"><span>{project.type}</span><span>{project.tools.length} tools</span></span>
            <figure class="object__media" data-sc-reveal={index % 2 === 0 ? 'up' : 'left'} data-sc-reveal-at={revealFor(index)}>
              <div class="object__frame" data-sc-tilt="4">
                <Image src={project.image} alt="" widths={[480, 960]} sizes="(max-width: 860px) 100vw, 40vw" loading={index < 2 ? 'eager' : 'lazy'} />
              </div>
            </figure>
            <span class="object__label">
              <span class="object__name">{project.name}</span>
              <span class="object__tagline">{project.tagline}</span>
              <span class="object__cta mono">open record</span>
            </span>
          </button>
        </li>
      ))}
    </ol>
  </div>
  <ProjectDialog />
</section>

<style>
  .objects { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2vw, 1.5rem); }
  .object__open {
    display: grid; gap: 0; width: 100%; text-align: left;
    background: none; border: 0; padding: 0; color: inherit; cursor: pointer;
  }
  .object__open .panel__bar { display: flex; }
  .object__media { margin: 0; }
  .object__frame { aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); border-bottom: 1px solid var(--hairline); }
  .object__frame img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 600ms var(--sc-ease-out); }
  .object__open:hover .object__frame img { transform: scale(1.03); }
  .object:hover { border-color: var(--hairline-strong); }
  .object__open:active { translate: 0 1px; }
  .object__label { display: grid; gap: var(--sc-1); padding: var(--sc-4); }
  .object__name { font-size: var(--sc-t-lg); font-weight: 560; letter-spacing: -0.01em; }
  .object__tagline { color: var(--ink-soft); font-size: var(--sc-t-sm); }
  .object__cta { color: var(--accent); margin-top: var(--sc-2); }

  @media (min-width: 1400px) {
    .objects { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 860px) {
    .objects { grid-template-columns: 1fr; }
  }
</style>
