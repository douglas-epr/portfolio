---
import { Image } from 'astro:assets';
import { BrainCircuit, Building2, Database, FileCheck2, Layers, PenTool, Settings2, Users, Workflow } from '@lucide/astro';
import { skills } from '@/data/skills';
import type { SkillCategory } from '@/types';

const groups: Array<{ category: SkillCategory; title: string; note: string; wide?: boolean }> = [
  { category: 'Stack', title: 'Stack', note: 'What the apps run on.' },
  { category: 'AI Tools', title: 'AI tools', note: 'How I build every app today.' },
  { category: 'Competencies', title: 'Competencies', note: 'From the CV, in its own words.' },
  { category: 'APIs', title: 'APIs integrated', note: 'Each one connected inside a client project.', wide: true },
];
const byCategory = (category: SkillCategory) => skills.filter((skill) => skill.category === category);
const icons = { BrainCircuit, Building2, Database, FileCheck2, Layers, PenTool, Settings2, Users, Workflow } as const;
type IconName = keyof typeof icons;
const iconFor = (name?: string) => (name && name in icons ? icons[name as IconName] : null);
---

<section id="skills" data-sc-act="pan" data-sc-act-phone="flow" data-sc-span="2.6" data-chapter-title="Stack">
  <div class="stack" data-sc-stage>
    <div class="rail" data-sc-pan="0.05">
      <div class="rail__item rail__lead" style="--i: 0">
        <p class="folio"><b>§05</b> · Stack</p>
        <h2 class="sc-display sc-display--md">The tools behind the work.</h2>
        <p class="sc-body">Every tool on this rail has been part of a client project. {skills.length} entries in four groups; the rail moves as you scroll.</p>
      </div>
      {groups.map((group, index) => {
        const items = byCategory(group.category);
        return (
          <div class:list={['rail__item', 'panel', { 'rail__item--wide': group.wide }]} style={`--i: ${index + 1}`}>
            <div class="panel__bar"><span>{group.title}</span><span><b>{items.length}</b></span></div>
            <div class="rail__body">
              <p class="rail__note">{group.note}</p>
              <ul class="tools">
                {items.map((skill) => {
                  const Icon = iconFor(skill.icon);
                  return (
                    <li class="tool">
                      {skill.logo ? (
                        <Image src={skill.logo} alt="" width={20} height={20} class="tool__logo" />
                      ) : Icon ? (
                        <span class="tool__icon" aria-hidden="true"><Icon size={16} /></span>
                      ) : (
                        <span class="tool__mark" aria-hidden="true"></span>
                      )}
                      <span>{skill.name}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        );
      })}
      <div class="rail__item rail__end" style="--i: 5">
        <p class="mono">Logos belong to their owners.</p>
        <p class="sc-body">Certified Senior Bubble Developer. The rest is on the CV.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stack { display: flex; align-items: flex-start; padding-top: calc(var(--nav-h) + var(--sc-5)); }
  .rail { gap: clamp(1.5rem, 3vw, 3rem); padding: 0 var(--sc-gutter); align-items: flex-start; }
  .rail__item { flex: 0 0 auto; width: clamp(16rem, 24vw, 22rem); max-height: calc(100svh - var(--nav-h) - 2 * var(--sc-5)); }
  .rail__item.panel { display: grid; grid-template-rows: auto 1fr; }
  .rail__item--wide { width: clamp(30rem, 44vw, 40rem); }
  .rail__lead { width: clamp(18rem, 28vw, 26rem); display: grid; gap: var(--sc-4); align-self: center; }
  .rail__end { width: clamp(14rem, 18vw, 18rem); display: grid; gap: var(--sc-3); color: var(--ink-soft); align-self: center; }
  .rail__end .mono { margin: 0; }
  .rail__body { padding: var(--sc-4); min-height: 0; overflow: auto; }
  .rail__note { margin: 0 0 var(--sc-3); font-size: var(--sc-t-sm); color: var(--ink-soft); }
  .tools { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .rail__item--wide .tools { grid-template-columns: 1fr 1fr; column-gap: var(--sc-5); }
  .tool { display: flex; align-items: center; gap: var(--sc-3); padding: var(--sc-2) 0; border-bottom: 1px solid var(--hairline); font-size: var(--sc-t-sm); }
  .tool__logo, .tool__mark, .tool__icon { width: 20px; height: 20px; flex: none; }
  .tool__logo { object-fit: contain; border-radius: 3px; }
  .tool__icon { display: grid; place-items: center; color: var(--accent); }
  .tool__mark { display: inline-block; width: 0.55rem; height: 1px; background: var(--accent); margin-inline: 0.3rem; }

  /* Items settle in sequence as the rail travels; the lead is exempt. */
  @media (prefers-reduced-motion: no-preference) {
    .rail__item:not(.rail__lead) {
      opacity: calc(0.55 + 0.45 * clamp(0, var(--sc-p, 1) * 6 - var(--i) + 1, 1));
      transform: translate3d(0, calc((1 - clamp(0, var(--sc-p, 1) * 6 - var(--i) + 1, 1)) * 10px), 0);
    }
  }
  .rail__item { --sc-p: inherit; }

  @media (max-width: 860px) {
    .rail__item, .rail__item--wide { width: min(80vw, 22rem); }
    .rail__item--wide .tools { grid-template-columns: 1fr; }
    .rail__lead { width: min(84vw, 22rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail { padding-block: var(--sc-7); }
  }

  /* Phones: the rail stacks into a plain column (phone-acts.ts). Every card full width and full strength. */
  #skills[data-phone-flow] .stack { padding: clamp(3rem, 9vw, 4rem) 0; }
  #skills[data-phone-flow] .rail { display: flex; flex-direction: column; align-items: stretch; gap: var(--sc-4); }
  #skills[data-phone-flow] .rail__item { width: auto; max-height: none; opacity: 1; transform: none; align-self: stretch; }
  #skills[data-phone-flow] .rail__body { overflow: visible; }
</style>
