---
import { Image } from 'astro:assets';
import { X, ArrowUpRight, Play } from '@lucide/astro';
import { projects } from '@/data/projects';

function paragraphs(text: string): Array<{ kind: 'p' | 'list'; lines: string[] }> {
  return text.split(/\n\n+/).map((block) => {
    const lines = block.split('\n').filter(Boolean);
    const isList = lines.every((line) => line.startsWith('- '));
    return isList ? { kind: 'list', lines: lines.map((line) => line.slice(2)) } : { kind: 'p', lines: [lines.join(' ')] };
  });
}
---

<dialog id="project-dialog" class="dialog ground--paper" aria-labelledby="project-dialog-title">
  <button class="dialog__close" type="button" data-dialog-close aria-label="Close project details" autofocus>
    <X size={20} aria-hidden="true" />
  </button>
  {projects.map((project) => (
    <article class="panel" hidden data-project-panel={project.id}>
      <figure class="panel__media">
        <Image src={project.image} alt={`${project.name} screenshot`} widths={[720, 1200]} sizes="(max-width: 860px) 100vw, 56rem" loading="lazy" />
      </figure>
      <header class="panel__head">
        <p class="mono panel__type">{project.type} · {project.tools.length} tools</p>
        <h3 class="sc-display sc-display--lg" data-dialog-heading>{project.name}</h3>
        <p class="panel__tagline">{project.tagline}</p>
      </header>
      <div class="panel__grid">
        <div class="panel__about">
          <h4 class="folio">About</h4>
          {paragraphs(project.description).map((block) =>
            block.kind === 'list' ? <ul>{block.lines.map((line) => <li>{line}</li>)}</ul> : <p>{block.lines[0]}</p>,
          )}
        </div>
        <div class="panel__side">
          <h4 class="folio">Key features</h4>
          <ul class="panel__features">{project.keyFeatures.map((feature) => <li>{feature}</li>)}</ul>
          <h4 class="folio">Tools</h4>
          <p class="mono panel__tools">{project.tools.join(' · ')}</p>
          <h4 class="folio">Links</h4>
          <ul class="panel__links">
            {project.websiteUrl ? <li><a class="text-link" href={project.websiteUrl} target="_blank" rel="noopener noreferrer">View live <ArrowUpRight size={14} aria-hidden="true" /></a></li> : null}
            {project.youtubeUrls?.map((url, index) => <li><a class="text-link" href={url} target="_blank" rel="noopener noreferrer">Watch demo{project.youtubeUrls && project.youtubeUrls.length > 1 ? ` ${index + 1}` : ''} <Play size={14} aria-hidden="true" /></a></li>)}
            {project.links?.map((link) => <li><a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <ArrowUpRight size={14} aria-hidden="true" /></a></li>)}
          </ul>
          {project.testimonyImage ? (
            <div class="panel__review">
              <h4 class="folio">Client review on Clutch</h4>
              <Image src={project.testimonyImage} alt={`Clutch review for ${project.name}`} widths={[480, 800]} sizes="(max-width: 860px) 100vw, 20rem" loading="lazy" />
              {project.testimonyLink ? <a class="text-link" href={project.testimonyLink} target="_blank" rel="noopener noreferrer">Read on Clutch <ArrowUpRight size={14} aria-hidden="true" /></a> : null}
            </div>
          ) : null}
        </div>
      </div>
    </article>
  ))}
</dialog>

<style>
  .dialog {
    width: min(64rem, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    margin: auto; padding: 0; border: 1px solid var(--paper-hairline);
    box-shadow: var(--sc-e3);
    overflow: auto;
  }
  .dialog::backdrop { background: rgb(21 22 26 / 0.7); }
  .dialog__close {
    position: sticky; top: var(--sc-4); float: right; margin: var(--sc-4) var(--sc-4) 0 0;
    background: var(--paper); color: var(--paper-ink); border: 1px solid var(--paper-hairline);
    width: 2.5rem; height: 2.5rem; display: grid; place-items: center; cursor: pointer; z-index: 2;
    transition: background var(--sc-d-fast) var(--sc-ease-out), color var(--sc-d-fast) var(--sc-ease-out);
  }
  .dialog__close:hover { background: var(--paper-ink); color: var(--paper); }
  .dialog__close:active { scale: 0.97; }
  .panel { padding: 0 clamp(1.25rem, 4vw, 3rem) clamp(2rem, 4vw, 3rem); clear: both; }
  .panel__media { margin: 0 calc(-1 * clamp(1.25rem, 4vw, 3rem)); border-bottom: 1px solid var(--paper-hairline); background: #dcdcd6; }
  .panel__media img { width: 100%; height: auto; max-height: 26rem; object-fit: cover; object-position: top; }
  .panel__head { padding: var(--sc-6) 0 var(--sc-5); display: grid; gap: var(--sc-2); }
  .panel__type { margin: 0; color: var(--sc-ink-soft); text-transform: uppercase; letter-spacing: var(--sc-track-wide); }
  .panel__tagline { margin: 0; font-size: var(--sc-t-lg); color: var(--sc-ink-soft); max-width: 40ch; text-wrap: pretty; }
  .panel__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); border-top: 1px solid var(--sc-ink); padding-top: var(--sc-5); }
  .panel__about p, .panel__about ul { color: var(--sc-ink-soft); font-size: var(--sc-t-sm); line-height: 1.6; text-wrap: pretty; }
  .panel__about p { margin: var(--sc-3) 0 0; }
  .panel__about ul { margin: var(--sc-3) 0 0; padding-left: 1.1em; }
  .panel__side { display: grid; gap: var(--sc-3); align-content: start; }
  .panel__side .folio { margin-top: var(--sc-3); }
  .panel__side .folio:first-child { margin-top: 0; }
  .panel__features { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--sc-2); font-size: var(--sc-t-sm); }
  .panel__features li { padding-left: var(--sc-4); position: relative; }
  .panel__features li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 0.5rem; height: 1px; background: var(--sc-accent); }
  .panel__tools { margin: 0; color: var(--sc-ink-soft); line-height: 1.6; }
  .panel__links { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--sc-2); font-size: var(--sc-t-sm); }
  .panel__links a { display: inline-flex; align-items: center; gap: 0.3em; }
  .panel__review { display: grid; gap: var(--sc-2); font-size: var(--sc-t-sm); }
  .panel__review img { width: 100%; height: auto; border: 1px solid var(--paper-hairline); }

  @media (max-width: 860px) {
    .panel__grid { grid-template-columns: 1fr; }
  }
</style>
