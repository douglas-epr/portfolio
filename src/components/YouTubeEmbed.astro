---
import { Play } from '@lucide/astro';

interface Props {
  id: string;
  title: string;
  start?: number;
}

const { id, title, start } = Astro.props;
const poster = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt" data-youtube={id} data-start={start ?? 0} data-title={title}>
  <button type="button" class="yt__poster" aria-label={`Play video: ${title}`}>
    <img src={poster} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="yt__play" aria-hidden="true">
      <Play size={18} />
      <span class="mono">play</span>
    </span>
  </button>
</div>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface-2); border-bottom: 1px solid var(--hairline); }
  /* The whole poster is the play target, not only the chip in its corner. */
  .yt__poster { position: absolute; inset: 0; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .yt__poster:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .yt img { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.7); transition: filter 300ms var(--sc-ease-out), transform 600ms var(--sc-ease-out); }
  .yt__poster:hover img, .yt__poster:focus-visible img { filter: none; transform: scale(1.02); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt__play {
    position: absolute; left: var(--sc-4); bottom: var(--sc-4);
    display: inline-flex; align-items: center; gap: var(--sc-2);
    padding: var(--sc-2) var(--sc-3); border: 1px solid var(--hairline-strong); border-radius: var(--sc-r-sm);
    background: var(--ground); color: var(--ink);
    pointer-events: none; transition: background var(--sc-d-fast) var(--sc-ease-out), color var(--sc-d-fast) var(--sc-ease-out), border-color var(--sc-d-fast) var(--sc-ease-out);
  }
  .yt__poster:hover .yt__play, .yt__poster:focus-visible .yt__play { background: var(--accent); border-color: var(--accent); color: var(--ground); }
  .yt__poster:active .yt__play { scale: 0.97; }
</style>
