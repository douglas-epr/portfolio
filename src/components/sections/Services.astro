---
import { services } from '@/data/services';
---

<section id="services" data-sc-act="pin" data-sc-span="2.4" data-chapter-title="Services">
  <div class="services" data-sc-stage data-stage-fit>
    <div class="sc-wrap services__grid" data-stage-fit-content>
      <header class="services__head">
        <p class="folio"><b>§04</b> · Services</p>
        <h2 class="sc-display sc-display--md">Six ways I can help you build.</h2>
        <p class="sc-body">Every project starts the same way: a written architecture, a data model and acceptance criteria before the first build, and a change log after it. You always know what is being built and why.</p>
        <p class="services__counter mono" aria-hidden="true">
          {services.map((_, index) => <span class="services__dot" style={`--i: ${index}`}></span>)}
        </p>
      </header>
      <div class="panel services__panel">
        <div class="panel__bar"><span>services</span><span>{services.length} rows</span></div>
        <ol class="clauses">
          {services.map((service, index) => (
            <li class="clause" style={`--i: ${index}`}>
              <span class="clause__num mono">4.{index + 1}</span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .services { display: flex; align-items: center; padding-top: var(--nav-h); }
  .services__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  .services__head { display: grid; gap: var(--sc-3); }
  .services__head .sc-display { max-width: 16ch; }
  .services__counter { display: flex; gap: var(--sc-2); margin: var(--sc-3) 0 0; }
  .services__dot { width: 1.6rem; height: 3px; border-radius: 2px; background: var(--hairline-strong); transform-origin: left; }
  /* All six clauses stay on the stage: two columns, three rows, no inner scroll. */
  .services__panel { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .clauses { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; }
  .clause { display: grid; grid-template-columns: 2.6rem 1fr; gap: var(--sc-3); padding: var(--sc-4); border-bottom: 1px solid var(--hairline); }
  .clause:nth-child(odd) { border-right: 1px solid var(--hairline); }
  .clause:nth-last-child(-n + 2) { border-bottom: 0; }
  .clause__num { color: var(--accent); padding-top: 0.3em; font-size: var(--sc-t-xs); }
  .clause h3 { margin: 0; font-size: var(--sc-t-base); font-weight: 560; letter-spacing: -0.01em; text-wrap: balance; }
  .clause p { margin: var(--sc-2) 0 0; color: var(--ink-soft); font-size: var(--sc-t-sm); line-height: 1.5; text-wrap: pretty; }
  @media (min-width: 861px) and (max-height: 820px) {
    .clause { padding: var(--sc-3) var(--sc-4); }
    .clause p { margin-top: var(--sc-1); line-height: 1.45; }
  }

  /* Full descriptions, never clamped. When they outgrow the viewport, stage-fit.ts
     writes the overflow to --fit-shift and the grid travels up by it as the pin
     runs, done by the time the last clause lights (p = 0.8). */
  .services__grid { transform: translate3d(0, calc(clamp(0, var(--sc-p, 0) / 0.8, 1) * var(--fit-shift, 0px) * -1), 0); }

  /* Each clause lights up in turn as the stage is pinned: the list is read to
     the visitor at the pace of their own hand. The dots mirror it. */
  @media (prefers-reduced-motion: no-preference) {
    .clause, .services__dot { --k: clamp(0, (var(--sc-p, 1) * 7.5 - var(--i) - 0.5), 1); }
    .clause { opacity: calc(0.28 + 0.72 * var(--k)); transform: translate3d(0, calc((1 - var(--k)) * 12px), 0); }
    .clause__num { opacity: calc(0.4 + 0.6 * var(--k)); }
    .services__dot { background: color-mix(in oklab, var(--accent) calc(var(--k) * 100%), var(--hairline-strong)); }
  }
  .clause, .services__dot { --sc-p: inherit; }

  @media (max-width: 860px) {
    .services { align-items: flex-start; padding-top: calc(var(--nav-h) + var(--sc-4)); }
    .services__grid { grid-template-columns: 1fr; gap: var(--sc-4); }
    .services__head .sc-body { display: none; }
    .services__head .sc-display { font-size: var(--sc-t-xl); }
    .clauses { grid-template-columns: 1fr; }
    .clause { padding: var(--sc-2) var(--sc-3); grid-template-columns: 2.2rem 1fr; }
    .clause:nth-child(odd) { border-right: 0; }
    .clause:nth-last-child(-n + 2) { border-bottom: 1px solid var(--hairline); }
    .clause:last-child { border-bottom: 0; }
    .clause h3 { font-size: var(--sc-t-sm); }
    .clause p { margin-top: var(--sc-1); font-size: var(--sc-t-xs); line-height: 1.45; }
  }
</style>
