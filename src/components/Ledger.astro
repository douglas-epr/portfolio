---
import { formatIndex } from '@/scripts/ledger';

interface Props {
  chapters: Array<{ id: string; title: string }>;
  factCount: number;
}

const { chapters, factCount } = Astro.props;
---

<aside class="ledger" data-ledger-panel data-sc-verify-state="0|0" aria-label="Reading ledger">
  <div class="ledger__head">
    <p class="sc-label">Ledger</p>
    <p class="ledger__chapter" data-ledger-chapter>§00 · {chapters[0]?.title}</p>
    <button class="ledger__toggle" type="button" data-ledger-toggle aria-expanded="false" aria-controls="ledger-body">Record</button>
  </div>
  <div class="ledger__body" id="ledger-body">
    <nav class="ledger__nav" data-ledger-nav aria-label="Chapters">
      <ol>
        {chapters.map((chapter, index) => (
          <li>
            <a href={`#${chapter.id}`}><span>{formatIndex(index)}</span><span>{chapter.title}</span></a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="ledger__record">
      <p class="sc-label">Record</p>
      <ol class="ledger__list" data-ledger-list aria-live="polite"></ol>
      <p class="ledger__count"><b data-ledger-count>0 of {factCount}</b> facts read</p>
    </div>
  </div>
</aside>
