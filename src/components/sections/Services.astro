---
import { services } from '@/data/services';
---

<section id="services" class="ground--dark chapter" data-sc-act="flow" data-chapter-title="Services">
  <div class="sc-wrap services">
    <header class="services__head" data-sc-in data-sc-stagger="60">
      <p class="folio"><b>§03</b> · Services</p>
      <h2 class="sc-display sc-display--lg">Six things you can hire me for.</h2>
      <p class="sc-body">Each one comes with the same working method: a written architecture, a data model and acceptance criteria before the first build, and a change log after it.</p>
    </header>
    <ol class="clauses" data-sc-in data-sc-stagger="70" data-ledger={`${services.length} services offered`}>
      {services.map((service, index) => (
        <li class="clause">
          <span class="clause__num mono">3.{index + 1}</span>
          <div>
            <h3 class="sc-display sc-display--md">{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .services__head { display: grid; gap: var(--sc-4); position: sticky; top: var(--sc-7); }
  .services__head .sc-display { max-width: 14ch; }
  .clauses { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--sc-ink); }
  .clause { display: grid; grid-template-columns: 3.5rem 1fr; gap: var(--sc-4); padding: var(--sc-5) 0; border-bottom: 1px solid var(--hairline); }
  .clause__num { color: var(--sc-accent); padding-top: 0.5em; }
  .clause h3 { margin: 0; }
  .clause p { margin: var(--sc-2) 0 0; color: var(--sc-ink-soft); font-size: var(--sc-t-sm); line-height: 1.55; max-width: 52ch; text-wrap: pretty; }

  @media (max-width: 860px) {
    .services { grid-template-columns: 1fr; }
    .services__head { position: static; }
  }
</style>
