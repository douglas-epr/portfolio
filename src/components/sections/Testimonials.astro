---
import { Image } from 'astro:assets';
import { testimonials } from '@/data/testimonials';

const LINKEDIN_PATH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<section id="testimonials" data-sc-act="pan" data-sc-act-phone="flow" data-sc-span="3" data-chapter-title="Clients">
  <div class="clients" data-sc-stage>
    <div class="rail" data-sc-pan="0.05">
      <div class="rail__item rail__lead" style="--i: 0">
        <p class="folio"><b>§07</b> · Clients</p>
        <h2 class="sc-display sc-display--md">What the people who paid for the work wrote afterwards.</h2>
        <p class="sc-body">{testimonials.length} recommendations from LinkedIn, quoted in full and unedited. They pass by as you scroll.</p>
      </div>
      {testimonials.map((quote, index) => (
        <article class="rail__item quote panel" style={`--i: ${index + 1}`}>
          <div class="panel__bar"><span>{quote.company}</span><span>{quote.date} · {quote.rating} of 5</span></div>
          <blockquote class="quote__text">
            <p>{quote.text}</p>
          </blockquote>
          <footer class="quote__by">
            <Image src={quote.photo} alt="" width={40} height={40} class="quote__photo" />
            <p class="quote__name">{quote.author}</p>
            {quote.linkedinUrl ? (
              <a class="quote__link" href={quote.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={`${quote.author} on LinkedIn`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={LINKEDIN_PATH}></path></svg>
              </a>
            ) : null}
          </footer>
        </article>
      ))}
      <div class="rail__item rail__end" style="--i: 8">
        <p class="mono">Verbatim. Names link to the source.</p>
        <p class="sc-body">Written on LinkedIn between January 2023 and October 2026.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .clients { display: flex; align-items: flex-start; padding-top: calc(var(--nav-h) + var(--sc-5)); }
  .rail { gap: clamp(1.5rem, 3vw, 3rem); padding: 0 var(--sc-gutter); align-items: flex-start; }
  .rail__item { flex: 0 0 auto; width: clamp(18rem, 26vw, 24rem); max-height: calc(100svh - var(--nav-h) - 2 * var(--sc-5)); }
  .rail__lead { width: clamp(18rem, 28vw, 26rem); display: grid; gap: var(--sc-4); align-self: center; }
  .rail__end { width: clamp(14rem, 18vw, 18rem); display: grid; gap: var(--sc-3); color: var(--ink-soft); align-self: center; }
  .rail__end .mono { margin: 0; }
  .quote { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .quote__text { margin: 0; padding: var(--sc-4); overflow: auto; min-height: 0; }
  .quote__text p { margin: 0; font-size: var(--sc-t-sm); line-height: 1.6; color: var(--ink); text-wrap: pretty; white-space: pre-line; }
  .quote__by { display: grid; grid-template-columns: auto 1fr auto; gap: var(--sc-3); align-items: center; padding: var(--sc-3) var(--sc-4); border-top: 1px solid var(--hairline); }
  .quote__photo { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .quote__name { margin: 0; font-size: var(--sc-t-sm); font-weight: 500; }
  .quote__link { color: var(--ink-soft); display: grid; place-items: center; width: 44px; height: 44px; margin: -6px; transition: color var(--sc-d-fast) var(--sc-ease-out); }
  .quote__link:hover { color: var(--accent); }

  @media (prefers-reduced-motion: no-preference) {
    .rail__item:not(.rail__lead) {
      opacity: calc(0.55 + 0.45 * clamp(0, var(--sc-p, 1) * 9 - var(--i) + 1, 1));
      transform: translate3d(0, calc((1 - clamp(0, var(--sc-p, 1) * 9 - var(--i) + 1, 1)) * 10px), 0);
    }
  }
  .rail__item { --sc-p: inherit; }

  @media (max-width: 860px) {
    .rail__item { width: min(80vw, 22rem); }
    .rail__lead { width: min(84vw, 22rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail { padding-block: var(--sc-7); }
  }

  /* Phones: the rail stacks into a plain column (phone-acts.ts). Every card full width and full strength. */
  #testimonials[data-phone-flow] .clients { padding: clamp(3rem, 9vw, 4rem) 0; }
  #testimonials[data-phone-flow] .rail { display: flex; flex-direction: column; align-items: stretch; gap: var(--sc-4); }
  #testimonials[data-phone-flow] .rail__item { width: auto; max-height: none; opacity: 1; transform: none; align-self: stretch; }
  #testimonials[data-phone-flow] .quote__text { overflow: visible; }
</style>
