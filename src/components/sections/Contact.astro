---
import { FileText } from '@lucide/astro';
import { person } from '@/data/person';
import { build } from '@/data/build';
import ContactForm from '@/components/ContactForm.astro';

const year = new Date().getFullYear();
const LINKEDIN_PATH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const YOUTUBE_PATH =
  'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z';
---

<section id="contact" class="chapter contact" data-sc-act="flow" data-chapter-title="Contact">
  <div class="sc-wrap">
    <div class="contact__grid">
      <div class="contact__lead" data-sc-in data-sc-stagger="60">
        <p class="folio"><b>§08</b> · Contact</p>
        <h2 class="sc-display sc-display--lg">Get in touch.</h2>
        <p class="sc-body">One project at a time, written up before it is built. Tell me what you are trying to ship and where the risk is.</p>
        <div class="panel">
          <div class="panel__bar"><span>channels</span><span>4 rows</span></div>
          <dl class="contact__facts">
            <div><dt>Email</dt><dd><a class="text-link" href={`mailto:${person.email}`}>{person.email}</a></dd></div>
            <div><dt>Phone</dt><dd><a class="text-link" href={`tel:${person.phone.replace(/[^\d+]/g, '')}`}>{person.phone}</a></dd></div>
            <div><dt>Base</dt><dd>{person.location}</dd></div>
            <div>
              <dt>Elsewhere</dt>
              <dd class="contact__links">
                <a class="text-link" href={person.linkedinUrl} target="_blank" rel="noopener noreferrer"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={LINKEDIN_PATH}></path></svg> LinkedIn</a>
                <a class="text-link" href={person.youtubeUrl} target="_blank" rel="noopener noreferrer"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={YOUTUBE_PATH}></path></svg> YouTube</a>
                <a class="text-link" href={person.cvUrl} download><FileText size={14} aria-hidden="true" /> CV (PDF)</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="contact__form" data-sc-in>
        <ContactForm />
      </div>
    </div>

    <footer class="colophon" data-sc-in>
      <p class="mono">Built with Astro and an AI coding agent, deployed on Vercel. {build.jsGzipKb} KB of JavaScript, gzipped, measured on {build.measuredAt}. Set in Geist and Geist Mono. Every figure on this page comes from the CV or from shipped work.</p>
      <p class="mono">© {year} {person.name}</p>
    </footer>
  </div>
</section>

<style>
  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .contact__lead { display: grid; gap: var(--sc-3); }
  .contact__lead .sc-display { letter-spacing: -0.03em; }
  .contact__lead .panel { margin-top: var(--sc-4); }
  .contact__facts { margin: 0; display: grid; }
  .contact__facts > div { display: grid; grid-template-columns: 6rem 1fr; gap: var(--sc-4); padding: var(--sc-3) var(--sc-4); border-bottom: 1px solid var(--hairline); font-size: var(--sc-t-sm); }
  .contact__facts > div:last-child { border-bottom: 0; }
  .contact__facts dt { font-family: var(--sc-font-mono); font-size: var(--sc-t-xs); letter-spacing: var(--sc-track-wide); text-transform: uppercase; color: var(--ink-soft); padding-top: 0.2em; }
  .contact__facts dd { margin: 0; }
  .contact__links { display: flex; flex-wrap: wrap; gap: var(--sc-4); }
  .contact__links a { display: inline-flex; align-items: center; gap: 0.35em; }
  .contact__form { padding-top: var(--sc-7); }
  .colophon { margin-top: clamp(3rem, 6vh, 5rem); padding-top: var(--sc-5); display: grid; gap: var(--sc-2); color: var(--ink-soft); border-top: 1px solid var(--hairline); }
  .colophon p { margin: 0; max-width: 80ch; }

  @media (max-width: 860px) {
    .contact__grid { grid-template-columns: 1fr; }
    .contact__form { padding-top: 0; }
  }
</style>
