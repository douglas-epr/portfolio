---
import { Play } from '@lucide/astro';

interface Props {
  id: string;
  title: string;
  start?: number;
}

const { id, title, start } = Astro.props;
const poster = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt" data-youtube={id} data-start={start ?? 0} data-title={title}>
  <img src={poster} alt="" width="480" height="360" loading="lazy" decoding="async" />
  <button type="button" class="yt__play" aria-label={`Play video: ${title}`}>
    <Play size={22} aria-hidden="true" />
    <span class="mono">Play</span>
  </button>
</div>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #23242a; border: 1px solid var(--hairline); }
  .yt img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.6) contrast(1.05); transition: filter 300ms var(--sc-ease-out), transform 600ms var(--sc-ease-out); }
  .yt:hover img { filter: none; transform: scale(1.02); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt__play {
    position: absolute; left: var(--sc-4); bottom: var(--sc-4);
    display: inline-flex; align-items: center; gap: var(--sc-2);
    padding: var(--sc-2) var(--sc-4); border: 1px solid var(--sc-ink); background: var(--sc-ink); color: var(--paper);
    cursor: pointer; transition: background var(--sc-d-fast) var(--sc-ease-out), color var(--sc-d-fast) var(--sc-ease-out);
  }
  .yt__play:hover { background: var(--sc-accent); border-color: var(--sc-accent); color: var(--sc-accent-ink); }
  .yt__play:active { scale: 0.97; }
</style>
