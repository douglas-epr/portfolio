---
import { person } from '@/data/person';
---

<div class="contact-form" data-contact data-state="idle">
  <form method="post" action="/api/contact" novalidate>
    <div class="field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" />
    </div>
    <div class="field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" required autocomplete="email" />
    </div>
    <div class="field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="6" required minlength="10" maxlength="2000"></textarea>
    </div>
    <div class="hp" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <p class="contact-form__error mono" data-contact-error role="alert"></p>
    <button class="submit" type="submit">Send the message</button>
    <noscript><p class="mono">JavaScript is off. Email me at <a class="text-link" href={`mailto:${person.email}`}>{person.email}</a>.</p></noscript>
  </form>
  <div class="contact-form__sent">
    <p class="sc-display sc-display--md">Received.</p>
    <p class="sc-body">Your message is in my inbox. I answer within two working days.</p>
    <button class="text-link reset" type="button" data-contact-reset>Send another</button>
  </div>
</div>

<style>
  .contact-form form { display: grid; gap: var(--sc-5); }
  .field { display: grid; gap: var(--sc-2); }
  .field label { font-family: var(--sc-font-mono); font-size: var(--sc-t-xs); letter-spacing: var(--sc-track-wide); text-transform: uppercase; color: var(--sc-ink-soft); }
  .field input, .field textarea {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--sc-ink);
    padding: var(--sc-2) 0; font-size: var(--sc-t-base); color: var(--sc-ink); border-radius: 0;
    transition: border-color var(--sc-d-fast) var(--sc-ease-out);
  }
  .field textarea { resize: vertical; min-height: 8rem; line-height: 1.5; }
  .field input:hover, .field textarea:hover { border-color: var(--sc-ink-soft); }
  .field input:focus-visible, .field textarea:focus-visible { outline: none; border-bottom: 2px solid var(--sc-accent); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .contact-form__error { margin: 0; color: var(--sc-accent); min-height: 1.4em; }
  .submit {
    justify-self: start; background: none; border: 0; padding: 0; cursor: pointer;
    font: inherit; font-size: var(--sc-t-lg); font-family: var(--sc-font-display); color: var(--sc-ink);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--sc-accent);
    transition: color var(--sc-d-fast) var(--sc-ease-out);
  }
  .submit:hover { color: var(--sc-accent); text-decoration-thickness: 2px; }
  .submit:active { translate: 0 1px; }
  .submit:disabled { opacity: 0.6; cursor: progress; }
  .contact-form__sent { display: none; gap: var(--sc-4); }
  .contact-form[data-state='sent'] form { display: none; }
  .contact-form[data-state='sent'] .contact-form__sent { display: grid; }
  .reset { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; justify-self: start; }
</style>
