---
import { Image } from 'astro:assets';
import { person } from '@/data/person';
import { experiences } from '@/data/experience';
import { educations } from '@/data/education';

const current = experiences[0];
const masters = educations[0];
---

<section id="about" class="chapter" data-sc-act="flow" data-chapter-title="About">
  <div class="sc-wrap about">
    <div class="about__copy sc-stack" data-sc-in data-sc-stagger="70">
      <p class="folio"><b>§01</b> · About</p>
      <h2 class="sc-display sc-display--md">Spec first. Then the code, and an AI to write most of it.</h2>
      <p class="about__bio">{person.bio}</p>
      <div class="panel">
        <div class="panel__bar"><span>facts · 2026 CV</span><span>3 rows</span></div>
        <dl class="about__facts">
          <div>
            <dt>Now</dt>
            <dd>{current?.role} at {current?.company}, since {current?.startDate}</dd>
          </div>
          <div>
            <dt>Education</dt>
            <dd>{masters?.degree} in {masters?.field}, {masters?.institution}</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>{person.location}. Remote, with clients in Brazil, Finland, the United Kingdom and the United States.</dd>
          </div>
        </dl>
      </div>
    </div>
    <figure class="about__figure panel">
      <div class="panel__bar"><span>photograph</span><span>{person.name}</span></div>
      <div class="about__frame" data-sc-reveal="left" data-sc-reveal-at="0.12 0.5">
        <Image src={person.profilePhoto} alt={`${person.name}, portrait`} widths={[480, 720, 960]} sizes="(max-width: 860px) 100vw, 24rem" loading="eager" data-sc-parallax="0.3" />
      </div>
    </figure>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 24rem); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .about__bio { color: var(--ink-soft); max-width: var(--sc-measure); text-wrap: pretty; margin: 0; }
  .about__copy .panel { margin-top: var(--sc-6); max-width: 40rem; }
  .about__facts { margin: 0; display: grid; }
  .about__facts > div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--sc-4); padding: var(--sc-3) var(--sc-4); border-bottom: 1px solid var(--hairline); }
  .about__facts > div:last-child { border-bottom: 0; }
  .about__facts dt { font-family: var(--sc-font-mono); font-size: var(--sc-t-xs); letter-spacing: var(--sc-track-wide); text-transform: uppercase; color: var(--ink-soft); padding-top: 0.2em; }
  .about__facts dd { margin: 0; font-size: var(--sc-t-sm); line-height: 1.5; }
  .about__figure { margin: 0; }
  .about__frame { aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface-2); }
  .about__frame img { width: 100%; height: 100%; object-fit: cover; object-position: top; scale: 1.08; }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; }
    .about__figure { order: -1; max-width: 20rem; }
    .about__facts > div { grid-template-columns: 5.5rem 1fr; }
  }
</style>
