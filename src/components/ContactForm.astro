---
import { person } from '@/data/person';
---

<div class="composer panel" data-contact data-state="idle">
  <div class="panel__bar"><span>composer · new message</span><span>to <b>{person.email}</b></span></div>
  <form method="post" action="/api/contact" novalidate>
    <div class="field">
      <label for="contact-name" class="mono">name</label>
      <input id="contact-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" placeholder="Ada Lovelace" />
    </div>
    <div class="field">
      <label for="contact-email" class="mono">email</label>
      <input id="contact-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
    </div>
    <div class="field field--message">
      <label for="contact-message" class="mono">message</label>
      <textarea id="contact-message" name="message" rows="6" required minlength="10" maxlength="2000" placeholder="What you want to build, and who it is for."></textarea>
    </div>
    <div class="hp" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div class="composer__foot">
      <p class="composer__error mono" data-contact-error role="alert"></p>
      <button class="send" type="submit"><span class="mono">send message</span> <span aria-hidden="true">↵</span></button>
    </div>
    <noscript><p class="mono composer__noscript">JavaScript is off. Email me at <a class="text-link" href={`mailto:${person.email}`}>{person.email}</a>.</p></noscript>
  </form>
  <div class="composer__sent">
    <p class="composer__ok">Received.</p>
    <p class="sc-body">Your message is in my inbox. The reply comes from me, not an autoresponder.</p>
    <button class="text-link reset" type="button" data-contact-reset>Send another</button>
  </div>
</div>

<style>
  .composer form { display: grid; }
  .field { display: grid; grid-template-columns: 6rem 1fr; align-items: center; border-bottom: 1px solid var(--hairline); }
  .field--message { grid-template-columns: 1fr; align-items: start; }
  .field label { color: var(--ink-soft); padding: var(--sc-3) var(--sc-4); }
  .field--message label { padding-bottom: 0; }
  .field input, .field textarea {
    width: 100%; background: transparent; border: 0; padding: var(--sc-3) var(--sc-4);
    font-size: var(--sc-t-base); color: var(--ink); border-radius: 0;
  }
  .field input::placeholder, .field textarea::placeholder { color: color-mix(in oklab, var(--ink-soft) 70%, transparent); }
  .field textarea { resize: vertical; min-height: 9rem; line-height: 1.5; }
  .field input:focus-visible, .field textarea:focus-visible { outline: none; background: var(--surface-2); }
  .field:focus-within { border-bottom-color: var(--accent); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .composer__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--sc-4); padding: var(--sc-3) var(--sc-4); }
  .composer__error { margin: 0; color: var(--accent); min-height: 1.4em; }
  .send {
    display: inline-flex; align-items: center; gap: var(--sc-2);
    background: var(--accent); color: var(--ground); border: 1px solid var(--accent); border-radius: var(--sc-r-sm);
    padding: var(--sc-2) var(--sc-4); cursor: pointer; font: inherit;
    transition: background var(--sc-d-fast) var(--sc-ease-out);
  }
  .send .mono { color: inherit; font-weight: 500; }
  .send:hover { background: color-mix(in oklab, var(--accent) 88%, white); }
  .send:active { translate: 0 1px; }
  .send:disabled { opacity: 0.6; cursor: progress; }
  .composer__noscript { padding: 0 var(--sc-4) var(--sc-4); color: var(--ink-soft); }
  .composer__sent { display: none; gap: var(--sc-3); padding: var(--sc-5) var(--sc-4); }
  .composer__ok { margin: 0; font-size: var(--sc-t-xl); font-weight: 560; letter-spacing: -0.01em; }
  .composer[data-state='sent'] form { display: none; }
  .composer[data-state='sent'] .composer__sent { display: grid; }
  .reset { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; justify-self: start; }

  @media (max-width: 860px) {
    .field { grid-template-columns: 1fr; }
    .field label { padding-bottom: 0; }
  }
</style>
