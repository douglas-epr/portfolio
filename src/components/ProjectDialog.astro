---
import { Image } from 'astro:assets';
import { X, ArrowUpRight, Play } from '@lucide/astro';
import { projects } from '@/data/projects';

function paragraphs(text: string): Array<{ kind: 'p' | 'list'; lines: string[] }> {
  return text.split(/\n\n+/).map((block) => {
    const lines = block.split('\n').filter(Boolean);
    const isList = lines.every((line) => line.startsWith('- '));
    return isList ? { kind: 'list', lines: lines.map((line) => line.slice(2)) } : { kind: 'p', lines: [lines.join(' ')] };
  });
}
---

<dialog id="project-dialog" class="dialog" aria-labelledby="project-dialog-title">
  <button class="dialog__close" type="button" data-dialog-close aria-label="Close project record" autofocus>
    <X size={18} aria-hidden="true" />
  </button>
  {projects.map((project) => (
    <article class="record" hidden data-project-panel={project.id}>
      <p class="panel__bar record__bar"><span>record · {project.id}</span><span>{project.type} · {project.tools.length} tools</span></p>
      <figure class="record__media">
        <Image src={project.image} alt={`${project.name} screenshot`} widths={[720, 1200]} sizes="(max-width: 860px) 100vw, 56rem" loading="lazy" />
      </figure>
      <header class="record__head">
        <h3 data-dialog-heading>{project.name}</h3>
        <p class="record__tagline">{project.tagline}</p>
      </header>
      <div class="record__grid">
        <div class="record__about">
          <h4 class="folio">About</h4>
          {paragraphs(project.description).map((block) =>
            block.kind === 'list' ? <ul>{block.lines.map((line) => <li>{line}</li>)}</ul> : <p>{block.lines[0]}</p>,
          )}
        </div>
        <div class="record__side">
          <h4 class="folio">Key features</h4>
          <ul class="record__features">{project.keyFeatures.map((feature) => <li>{feature}</li>)}</ul>
          <h4 class="folio">Tools</h4>
          <p class="mono record__tools">{project.tools.join(' · ')}</p>
          <h4 class="folio">Links</h4>
          <ul class="record__links">
            {project.websiteUrl ? <li><a class="text-link" href={project.websiteUrl} target="_blank" rel="noopener noreferrer">View live <ArrowUpRight size={14} aria-hidden="true" /></a></li> : null}
            {project.youtubeUrls?.map((url, index) => <li><a class="text-link" href={url} target="_blank" rel="noopener noreferrer">Watch demo{project.youtubeUrls && project.youtubeUrls.length > 1 ? ` ${index + 1}` : ''} <Play size={14} aria-hidden="true" /></a></li>)}
            {project.links?.map((link) => <li><a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <ArrowUpRight size={14} aria-hidden="true" /></a></li>)}
          </ul>
          {project.testimonyImage ? (
            <div class="record__review">
              <h4 class="folio">Client review on Clutch</h4>
              <Image src={project.testimonyImage} alt={`Clutch review for ${project.name}`} widths={[480, 800]} sizes="(max-width: 860px) 100vw, 20rem" loading="lazy" />
              {project.testimonyLink ? <a class="text-link" href={project.testimonyLink} target="_blank" rel="noopener noreferrer">Read on Clutch <ArrowUpRight size={14} aria-hidden="true" /></a> : null}
            </div>
          ) : null}
        </div>
      </div>
    </article>
  ))}
</dialog>

<style>
  .dialog {
    width: min(64rem, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    margin: auto; padding: 0;
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--hairline-strong); border-radius: var(--sc-r-md);
    box-shadow: var(--sc-e3);
    overflow: auto;
  }
  .dialog::backdrop { background: rgb(21 23 26 / 0.75); }
  .dialog__close {
    position: sticky; top: var(--sc-3); float: right; margin: var(--sc-3) var(--sc-3) 0 0;
    background: var(--ground); color: var(--ink); border: 1px solid var(--hairline-strong); border-radius: var(--sc-r-sm);
    width: 2.25rem; height: 2.25rem; display: grid; place-items: center; cursor: pointer; z-index: 2;
    transition: background var(--sc-d-fast) var(--sc-ease-out), color var(--sc-d-fast) var(--sc-ease-out);
  }
  .dialog__close:hover { background: var(--accent); border-color: var(--accent); color: var(--ground); }
  .dialog__close:active { scale: 0.97; }
  .record { clear: both; }
  .record__bar { margin: 0; }
  .record__media { margin: 0; border-bottom: 1px solid var(--hairline); background: var(--surface-2); }
  .record__media img { width: 100%; height: auto; max-height: 26rem; object-fit: cover; object-position: top; }
  .record__head { padding: var(--sc-5) clamp(1.25rem, 4vw, 3rem) var(--sc-4); display: grid; gap: var(--sc-2); }
  .record__head h3 { margin: 0; font-size: var(--sc-t-2xl); font-weight: 600; letter-spacing: -0.02em; line-height: 1.05; }
  .record__tagline { margin: 0; font-size: var(--sc-t-lg); color: var(--ink-soft); max-width: 40ch; text-wrap: pretty; }
  .record__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); border-top: 1px solid var(--hairline); padding: var(--sc-5) clamp(1.25rem, 4vw, 3rem) clamp(2rem, 4vw, 3rem); }
  .record__about p, .record__about ul { color: var(--ink-soft); font-size: var(--sc-t-sm); line-height: 1.6; text-wrap: pretty; }
  .record__about p { margin: var(--sc-3) 0 0; }
  .record__about ul { margin: var(--sc-3) 0 0; padding-left: 1.1em; }
  .record__side { display: grid; gap: var(--sc-3); align-content: start; }
  .record__side .folio { margin-top: var(--sc-3); }
  .record__side .folio:first-child { margin-top: 0; }
  .record__features { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--sc-2); font-size: var(--sc-t-sm); }
  .record__features li { padding-left: var(--sc-4); position: relative; }
  .record__features li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 0.5rem; height: 1px; background: var(--accent); }
  .record__tools { margin: 0; color: var(--ink-soft); line-height: 1.6; }
  .record__links { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--sc-2); font-size: var(--sc-t-sm); }
  .record__links a { display: inline-flex; align-items: center; gap: 0.3em; }
  .record__review { display: grid; gap: var(--sc-2); font-size: var(--sc-t-sm); }
  .record__review img { width: 100%; height: auto; border: 1px solid var(--hairline); border-radius: var(--sc-r-sm); }

  @media (max-width: 860px) {
    .record__grid { grid-template-columns: 1fr; }
  }
</style>
