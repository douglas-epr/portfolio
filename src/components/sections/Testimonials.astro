---
import { Image } from 'astro:assets';
import { testimonials } from '@/data/testimonials';

const LINKEDIN_PATH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<section id="testimonials" class="ground--paper chapter" data-sc-act="flow" data-chapter-title="Clients">
  <div class="sc-wrap">
    <header class="chapter__head" data-sc-in data-sc-stagger="60">
      <p class="folio"><b>§06</b> · Clients</p>
      <h2 class="sc-display sc-display--lg">What the people who paid for the work wrote afterwards.</h2>
      <p class="sc-body">{testimonials.length} recommendations, quoted in full and unedited, from LinkedIn.</p>
    </header>

    <ol class="quotes" data-sc-in data-sc-stagger="90">
      {testimonials.map((quote) => (
        <li class="quote">
          <blockquote class="quote__text">
            <p>{quote.text}</p>
          </blockquote>
          <footer class="quote__by" data-ledger={`${quote.author} · ${quote.company} · ${quote.date}`}>
            <Image src={quote.photo} alt="" width={44} height={44} class="quote__photo" />
            <div>
              <p class="quote__name">{quote.author}</p>
              <p class="quote__meta mono">{quote.company} · {quote.date} · {quote.rating} of 5</p>
            </div>
            {quote.linkedinUrl ? (
              <a class="quote__link" href={quote.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={`${quote.author} on LinkedIn`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={LINKEDIN_PATH}></path></svg>
              </a>
            ) : null}
          </footer>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .quotes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 4rem) clamp(2rem, 5vw, 5rem); border-top: 1px solid var(--sc-ink); padding-top: clamp(2rem, 4vw, 3rem); }
  .quote { display: grid; gap: var(--sc-4); align-content: start; }
  .quote__text { margin: 0; }
  .quote__text p { margin: 0; font-family: var(--sc-font-display); font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); line-height: 1.3; letter-spacing: -0.005em; text-wrap: pretty; hanging-punctuation: first; }
  .quote__text p::before { content: '“'; color: var(--sc-accent); }
  .quote__text p::after { content: '”'; color: var(--sc-accent); }
  .quote__by { display: grid; grid-template-columns: auto 1fr auto; gap: var(--sc-3); align-items: center; padding-top: var(--sc-3); border-top: 1px solid var(--hairline); }
  .quote__photo { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .quote__name { margin: 0; font-size: var(--sc-t-sm); font-weight: 500; }
  .quote__meta { margin: 2px 0 0; color: var(--sc-ink-soft); }
  .quote__link { color: var(--sc-ink-soft); display: grid; place-items: center; width: 2rem; height: 2rem; transition: color var(--sc-d-fast) var(--sc-ease-out); }
  .quote__link:hover { color: var(--sc-accent); }

  @media (min-width: 1400px) {
    .quotes { grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 3rem); }
  }
  @media (max-width: 860px) {
    .quotes { grid-template-columns: 1fr; }
  }
</style>
